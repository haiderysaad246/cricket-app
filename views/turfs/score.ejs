<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head.ejs', { title: 'Cricket | Score Ball' }) %>
</head>
<body class="score-body"></body>
    <div class="score-page">
        <div class="score-page-top">
            <a href="/turfs/live/<%= match._id %>" class="score-page-back-link">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Back to Match</span>
            </a>
            </button>
            <button type="button" class="toolbar-btn toolbar-btn-danger" id="endInningsBtn" style="margin-bottom:10px;">
                <i class="fa-solid fa-flag-checkered"></i>
                <span>End Innings</span>
            </button>
            <div id="liveScoreSummaryWrapper">
                <%- include('./includes/live-score-summary.ejs', { match }) %>
            </div>
        </div>

        <!-- Input box: header shows a live preview of the current selection,
             back-bar steps up one level, grid shows the current level's
             options, Done saves once a leaf option is picked. Only the
             Runs branch is wired up for now — Out/Wide/No Ball are
             disabled placeholders until we build those next. -->
        <div class="score-page-input-box" id="scoreInputBox">
            <button type="button" class="score-pad-undo-btn" id="scorePadUndoBtn" title="Undo last ball" style="display:none;">
    <i class="fa-solid fa-rotate-left"></i>
</button>
<button type="button" class="score-pad-close-btn" id="scorePadCloseBtn" title="Cancel — nothing will be recorded" style="display:none;">
    <i class="fa-solid fa-xmark"></i>
</button>
            <div class="score-pad-header" id="scorePadHeader"></div>
            <div class="score-pad-backbar" id="scorePadBackBar">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Back</span>
            </div>
            <div class="score-pad-grid" id="scorePadGrid"></div>
            <button type="button" class="toolbar-btn toolbar-btn-primary" id="setPlayersBtn" style="display:none; margin:20px auto;">
                <i class="fa-solid fa-users"></i>
                <span>Set Players</span>
            </button>
        </div>
    </div>
<div class="confirm-overlay" id="scoreSetupOverlay">
    <div class="confirm-modal turf-form-modal">
        <button type="button" class="score-pad-close-btn modal-x-close" id="closeScoreSetup" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <h2 class="add-player-title">Set Players</h2>
        <form class="add-player-form" id="scoreSetupForm">
            <div class="form-group">
                <label>Striker (on strike)</label>
                <button type="button" class="toolbar-btn role-pick-btn" data-role="striker">
                    <i class="fa-solid fa-plus"></i>
                    <span>Select Player</span>
                </button>
                <div class="role-picked-chip" id="spStriker"></div>
            </div>
            <div class="form-group">
                <label>Non-Striker</label>
                <button type="button" class="toolbar-btn role-pick-btn" data-role="nonStriker">
                    <i class="fa-solid fa-plus"></i>
                    <span>Select Player</span>
                </button>
                <div class="role-picked-chip" id="spNonStriker"></div>
            </div>
            <div class="form-group">
                <label>Bowler</label>
                <button type="button" class="toolbar-btn role-pick-btn" data-role="bowler">
                    <i class="fa-solid fa-plus"></i>
                    <span>Select Player</span>
                </button>
                <div class="role-picked-chip" id="spBowler"></div>
            </div>
            <div class="form-actions">
                <button type="button" class="toolbar-btn" id="cancelScoreSetup">Cancel</button>
                <button type="submit" class="toolbar-btn toolbar-btn-primary">
                    <i class="fa-solid fa-check"></i>
                    <span>Save</span>
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('../includes/card-picker.ejs', { showClose: 'true' }) %>

    <script>
        window.MATCH = <%- JSON.stringify(match) %>;
    </script>
    <%- include('../includes/scripts.ejs') %>
    <script src="/js/score.js"></script>
</body>
</html>