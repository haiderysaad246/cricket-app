<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head.ejs', { title: 'Cricket | Live Match' }) %>
</head>
<body class="<%= match.tournamentId ? 'tcl-theme' : '' %>">
    <%- include('../includes/navbar.ejs') %>

    <div class="live-page">
        <a href="<%= match.tournamentId ? '/tcl/session/' + match.tournamentId : '/turfs/session/' + match.turfId %>" class="score-page-back-link" style="margin-bottom:14px;display:inline-flex;">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back</span>
        </a>
        <% if (isAdmin) { %>
        <div class="live-end-match-form">
            <form action="/turfs/live/<%= match._id %>/end" method="POST"
                  onsubmit="return confirm('End this match? Do this only once both innings are finished.');">
                <button type="submit" class="toolbar-btn toolbar-btn-danger">
                    <i class="fa-solid fa-flag-checkered"></i>
                    <span>End Match</span>
                </button>
            </form>
            <form action="/turfs/live/<%= match._id %>/cancel" method="POST"
                  onsubmit="return confirm('Cancel this match? This deletes it and cannot be undone.');">
                <button type="submit" class="toolbar-btn">
                    <i class="fa-solid fa-xmark"></i>
                    <span>Cancel Match</span>
                </button>
            </form>
        </div>
    <% } %>

        <!-- Score summary card -->
        <div id="liveViewSummary" style="display:contents;">
            <%- include('./includes/live-score-summary.ejs', { match, chain }) %>
        </div>

        <% const battingFirstTeam = match.battingFirst === 'team2' ? match.team2 : match.team1; %>
         
        <div class="live-match-status">
            <%= battingFirstTeam.name %> bats first &middot; <%= match.overs %> overs a side
        </div>

        <% if (isAdmin) { %>
        <div class="scoring-toolbar">
            <button type="button" class="toolbar-btn toolbar-btn-primary" id="startInningsBtn">
                <i class="fa-solid fa-play"></i>
                <span id="startInningsLabel">Start</span>
            </button>
            <button type="button" class="toolbar-btn toolbar-btn-primary" id="scoreBallBtn" style="display:none;">
                <i class="fa-solid fa-circle-play"></i>
                <span>Resume</span>
            </button>
        </div>
        <% } %>

        <!-- This match is saved in the DB (see /turfs/live/<id>), so a
             refresh or closing/reopening the app just re-loads this same
             page — nothing here is lost. Ending the match is the only
             thing that removes it from the "Resume Match" card on /turfs. -->
        

        <!-- Only a Scorecard is needed — Summary/Commentary tabs and the
             video highlights section from the reference design are removed.
             This toggle just switches which team's innings scorecard is shown.
             The team batting first opens as the active tab by default. -->
        <%
            // Tabs always follow innings order (1st innings first, 2nd
            // innings second) — that order never moves. What DOES move,
            // to stay consistent with the top score card, is which side
            // is "active" by default: whichever innings is currently live.
            const firstInningsKey = match.battingFirst;
            const secondInningsKey = firstInningsKey === "team1" ? "team2" : "team1";
        %>
        <div class="scorecard-tabs">
            <button type="button" class="scorecard-tab" data-innings="players">Players</button>
            <button type="button" class="scorecard-tab <%= match.currentInnings === firstInningsKey ? 'active' : '' %>" data-innings="<%= firstInningsKey %>">1st Innings</button>
            <button type="button" class="scorecard-tab <%= match.currentInnings === secondInningsKey ? 'active' : '' %>" data-innings="<%= secondInningsKey %>">2nd Innings</button>
            <button type="button" class="scorecard-tab" data-innings="mvp"><i class="fa-solid fa-star"></i> MVP</button>
            <button type="button" class="scorecard-tab" data-innings="records"><i class="fa-solid fa-list"></i> Full Records</button>
        </div>

        <div class="scorecard-innings" id="innings-players" style="display:none;">
            <div class="scorecard-block">
                <h3 class="scorecard-section-title">Players</h3>
                <div class="scorecard-table-wrap">
                    <table class="scorecard-table">
                        <thead>
                            <tr>
                                <th class="col-player"><%= match.team1.name %></th>
                                <th class="col-player"><%= match.team2.name %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const team1Players = (match.team1.batting && match.team1.batting.length) ? match.team1.batting : (match.team2.bowling || []); %>
                            <% const team2Players = (match.team2.batting && match.team2.batting.length) ? match.team2.batting : (match.team1.bowling || []); %>
                            <% const maxPlayers = Math.max(team1Players.length, team2Players.length); %>
                            <% if (!maxPlayers) { %>
                                <tr>
                                    <td class="col-player" colspan="2" style="color:#9ca3af; padding:16px; text-align:center;">No player roster data available yet.</td>
                                </tr>
                            <% } %>
                            <% for (let i = 0; i < maxPlayers; i++) { %>
                                <tr>
<td class="col-player">
                                        <% if (team1Players[i]) { %>
                                            <div class="scorecard-player-cell">
                                            <span class="scorecard-pic-wrap">
                                                <img src="<%= team1Players[i].image || '/images/placeholder-player.svg' %>" alt="<%= team1Players[i].name %>" class="scorecard-pic" onerror="this.onerror=null;this.src='/images/placeholder-player.svg';">
                                                <% if (team1Players[i].isCaptain) { %>
                                                    <i class="fa-solid fa-crown scorecard-captain-badge" title="Captain"></i>
                                                <% } %>
                                            </span>
                                            <div class="scorecard-player-info">
                                                <span class="scorecard-player-name"><%= team1Players[i].name %><% if (team1Players[i].isCaptain) { %> <span class="scorecard-captain-tag">(C)</span><% } %></span>
                                                <span class="scorecard-player-status"><%= team1Players[i].status || 'Player' %></span>
                                            </div>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td class="col-player">
                                        <% if (team2Players[i]) { %>
                                            <div class="scorecard-player-cell">
                                            <span class="scorecard-pic-wrap">
                                                <img src="<%= team2Players[i].image || '/images/placeholder-player.svg' %>" alt="<%= team2Players[i].name %>" class="scorecard-pic" onerror="this.onerror=null;this.src='/images/placeholder-player.svg';">
                                                <% if (team2Players[i].isCaptain) { %>
                                                    <i class="fa-solid fa-crown scorecard-captain-badge" title="Captain"></i>
                                                <% } %>
                                            </span>
                                            <div class="scorecard-player-info">
                                                <span class="scorecard-player-name"><%= team2Players[i].name %><% if (team2Players[i].isCaptain) { %> <span class="scorecard-captain-tag">(C)</span><% } %></span>
                                                <span class="scorecard-player-status"><%= team2Players[i].status || 'Player' %></span>
                                            </div>
                                            </div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="scorecard-innings" id="innings-<%= firstInningsKey %>" style="<%= match.currentInnings !== firstInningsKey ? 'display:none;' : '' %>">
            <%- include('./scorecard-innings.ejs', { battingTeam: match[firstInningsKey], bowlingTeamName: match[secondInningsKey].name, target: match.currentInnings === secondInningsKey ? (match[secondInningsKey].totalRuns || 0) + 1 : null, matchFinished: !!match.result }) %>
        </div>

        <div class="scorecard-innings" id="innings-<%= secondInningsKey %>" style="<%= match.currentInnings !== secondInningsKey ? 'display:none;' : '' %>">
            <%- include('./scorecard-innings.ejs', { battingTeam: match[secondInningsKey], bowlingTeamName: match[firstInningsKey].name, target: match.currentInnings === secondInningsKey ? (match[firstInningsKey].totalRuns || 0) + 1 : null, matchFinished: !!match.result }) %>
        </div>

        <div class="scorecard-innings" id="innings-mvp" style="display:none;">
            <div id="mvpPanelContent"></div>
        </div>

        <div class="scorecard-innings" id="innings-records" style="display:none;">
            <div class="scorecard-block full-records">
                <h3 class="scorecard-section-title">Full Records</h3>
                <% const events = match.ballEvents || []; %>
                <% const recordBallValue = (event) => {
                    const payload = event.payload || {};
                    if (payload.type === 'dot') return '0';
                    if (payload.type === 'one' || payload.type === 'one_nr') return '1';
                    if (payload.type === 'two') return '2';
                    if (payload.type === 'three') return '3';
                    if (payload.type === 'four') return '4';
                    if (payload.type === 'five') return '5';
                    if (payload.type === 'six') return '6';
                    if (payload.type === 'runs_extra') return String(payload.runs || 0);
                    if (payload.type === 'wide') {
                        const count = event.wideCount || (1 + Math.max(0, Number(payload.wideRuns || 0)));
                        return count === 1 ? 'wd' : `wd+${count - 1}`;
                    }
                    if (payload.type === 'noball') return `nb${payload.noballRuns ? `+${payload.noballRuns}` : ''}`;
                    if (payload.type === 'out') return payload.isNoBall ? 'nb+W' : (payload.isWide ? 'wd+W' : 'W');
                    return '•';
                }; %>
                <% const recordBallClass = (value) => value.toLowerCase().startsWith('wd') ? 'is-wide' : (value.toLowerCase().startsWith('nb') ? 'is-no-ball' : (value.toLowerCase() === 'w' ? 'is-wicket' : '')); %>
                <% const collapseWideEvents = (events) => {
                    const collapsed = [];
                    for (const event of events) {
                        const payload = event.payload || {};
                        const previous = collapsed[collapsed.length - 1];
                        if (payload.type === 'wide' && previous && previous.payload && previous.payload.type === 'wide' &&
                            previous.over === event.over && previous.ball === event.ball) {
                            previous.wideCount += 1 + Math.max(0, Number(payload.wideRuns || 0));
                            previous.sentence = `${previous.bowler || 'Bowler'} bowls ${previous.wideCount} wides`;
                            continue;
                        }
                        collapsed.push({
                            ...event,
                            payload,
                            wideCount: payload.type === 'wide' ? 1 + Math.max(0, Number(payload.wideRuns || 0)) : 0,
                        });
                    }
                    for (const event of collapsed) {
                        if (event.payload.type === 'wide' && event.wideCount === 1) {
                            event.sentence = `${event.bowler || 'Bowler'} bowls a wide`;
                        }
                    }
                    return collapsed;
                }; %>
                <% for (const inningsKey of [firstInningsKey, secondInningsKey]) { %>
                    <% const inningsEvents = collapseWideEvents(events.filter((event) => event.innings === inningsKey)); %>
                    <section class="records-innings">
                        <h4><%= match[inningsKey].name %> — <%= inningsKey === firstInningsKey ? '1st' : '2nd' %> innings</h4>
                        <% const overs = [...new Set(inningsEvents.map((event) => event.over))]; %>
                        <% if (!overs.length) { %><p class="records-empty">No deliveries recorded yet.</p><% } %>
                        <% for (const over of overs) { %>
                            <div class="records-over">
                                <% const overEvents = inningsEvents.filter((item) => item.over === over); %>
                                <div class="records-over-heading">
                                    <strong>Over <%= over %></strong>
                                    <div class="live-over-balls" aria-label="Over ball results">
                                        <% for (const event of overEvents) { %>
                                            <% const value = recordBallValue(event); %>
                                            <span class="over-ball-chip <%= recordBallClass(value) %>"><%= value %></span>
                                        <% } %>
                                    </div>
                                </div>
                                <ol>
                                    <% for (const event of overEvents) { %>
                                        <li><span class="records-ball"><%= event.legal ? `${over}.${event.ball}` : `${over}.${event.ball}*` %></span><%= event.sentence %></li>
                                    <% } %>
                                </ol>
                            </div>
                        <% } %>
                    </section>
                <% } %>
                <% if (!events.length) { %><p class="records-empty">Ball-by-ball records will appear here as scoring begins.</p><% } %>
            </div>
        </div>
    </div>

    <% if (isAdmin) { %>
    <!-- Innings setup: full 4-field form the first time (right after
         creating the match); "Change Players" later only re-opens this
         with the striker/non-striker/bowler section hidden, keeper only. -->
    <div class="confirm-overlay" id="inningsSetupOverlay">
        <div class="confirm-modal turf-form-modal">
            <button type="button" class="score-pad-close-btn modal-x-close" id="closeInningsSetup" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h2 class="add-player-title">Set Players</h2>
            <form class="add-player-form" id="inningsSetupForm">
                <div id="initialSetupFields">
                    <div class="form-group">
                        <label>Striker (on strike)</label>
                        <button type="button" class="toolbar-btn role-pick-btn" data-role="striker">
                            <i class="fa-solid fa-plus"></i>
                            <span>Select Player</span>
                        </button>
                        <div class="role-picked-chip" id="pickedStriker"></div>
                    </div>
                    <div class="form-group">
                        <label>Non-Striker</label>
                        <button type="button" class="toolbar-btn role-pick-btn" data-role="nonStriker">
                            <i class="fa-solid fa-plus"></i>
                            <span>Select Player</span>
                        </button>
                        <div class="role-picked-chip" id="pickedNonStriker"></div>
                    </div>
                    <div class="form-group">
                        <label>Bowler</label>
                        <button type="button" class="toolbar-btn role-pick-btn" data-role="bowler">
                            <i class="fa-solid fa-plus"></i>
                            <span>Select Player</span>
                        </button>
                        <div class="role-picked-chip" id="pickedBowler"></div>
                    </div>
                </div>
            </button>
                <div class="form-actions">
                    <button type="button" class="toolbar-btn" id="cancelInningsSetup">Cancel</button>
                    <button type="submit" class="toolbar-btn toolbar-btn-primary">
                        <i class="fa-solid fa-check"></i>
                        <span>Save</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

<!-- Shared single-select card picker, reused for every player choice above -->
    <% } %>
    <%- include('../includes/card-picker.ejs') %>

    <script>
        window.MATCH = <%- JSON.stringify(match) %>;
        window.IS_ADMIN = <%- isAdmin ? 'true' : 'false' %>;
    </script>
    <%- include('../includes/scripts.ejs') %>
    <script src="/js/live.js"></script>
    <script src="/js/mvp.js"></script>
    <script src="/js/live-auto-refresh.js"></script>
</body>
</html>