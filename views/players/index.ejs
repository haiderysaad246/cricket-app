<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head.ejs', { title: 'Cricket | Players' }) %>
</head>
<body>
    <%- include('../includes/navbar.ejs') %>

    <div class="players-page">
        <% if (isAdmin) { %>
        <div class="players-toolbar">
            <a class="toolbar-btn toolbar-btn-primary" href="/players/new">
                <i class="fa-solid fa-plus"></i>
                <span>Add Player</span>
            </a>
        </div>
        <% } %>

        <div class="players-grid">
            <% if (typeof allplayer !== 'undefined' && allplayer.length > 0) { %>
                <% allplayer.forEach(player => { %>
                    <div class="player-card">
                        <a href="/players/<%= player._id %>/profile" class="player-card-link">
                            <div class="player-pic-ring">
    <img src="<%= player.image %>" alt="<%= player.name %>" class="player-pic" onerror="this.onerror=null;this.src='/images/placeholder-player.svg';">
    <span class="player-rank-badge"><%= player.rank || '' %></span>
</div>
                            <div class="player-info">
                                <span class="player-name"><%= player.name %></span>
                                <span class="player-meta"><%= player.handed %> &middot; <%= player.role %></span>
                            </div>
                        </a>

                        <div class="player-menu dropdown">
                            <button class="menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Player options">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <ul class="dropdown-menu player-dropdown">
                                <li>
                                    <a class="dropdown-item" href="/players/<%= player._id %>/edit">
                                        <i class="fa-solid fa-pen"></i>
                                        <span>Edit</span>
                                    </a>
                                </li>
                                <% if (isAdmin) { %>
                                <li>
                                    <button type="button" class="dropdown-item delete-item"
                                            data-delete-id="<%= player._id %>"
                                            data-delete-name="<%= player.name %>">
                                        <i class="fa-solid fa-trash"></i>
                                        <span>Delete</span>
                                    </button>
                                </li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="no-players">No players added yet.</p>
            <% } %>
        </div>
    </div>

    <!-- Delete confirmation modal — shared by every player card's Delete button -->
    <div class="confirm-overlay" id="deletePlayerOverlay">
        <div class="confirm-modal">
            <h2 class="add-player-title">Delete Player?</h2>
            <p>Are you sure you want to delete <strong id="deletePlayerName"></strong>? This can't be undone.</p>

            <form id="deletePlayerForm" method="POST">
                <div class="confirm-actions">
                    <button type="button" class="toolbar-btn" id="cancelDeletePlayer">Cancel</button>
                    <button type="submit" class="toolbar-btn toolbar-btn-danger">
                        <i class="fa-solid fa-trash"></i>
                        <span>Delete</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../includes/scripts.ejs') %>
    <script src="/js/players.js"></script>
</body>
</html>