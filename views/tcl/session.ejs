<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../includes/head.ejs', { title: 'Cricket | ' + tournament.name }) %>
</head>
<body class="tcl-theme">
    <%- include('../includes/navbar.ejs') %>

    <div class="players-page">
        <a href="/tcl" class="score-page-back-link" style="margin-bottom:16px;display:inline-flex;">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to TCL</span>
        </a>
        <% if (sessionError) { %>
            <div class="tcl-session-error" role="alert"><%= sessionError %></div>
        <% } %>

        <% const liveMatch = matches.find(m => m.status === 'live') || null; %>
        <% const tournamentOvers = tournament.overs || (matches.find(m => m.stage === 'fixture') || {}).overs || 6; %>
        <div class="resume-match-card" style="margin-bottom:16px; position:relative;">
            <div class="resume-match-info">
                <i class="fa-solid fa-trophy resume-match-icon"></i>
                <div>
                    <div class="resume-match-title"><%= tournament.name %></div>
                    <% if (tournament.date) { %>
                        <div class="resume-match-sub"><%= tournament.date %></div>
                    <% } %>
                </div>
            </div>
            <% if (liveMatch) { %>
                <div class="resume-live-badge">LIVE</div>
            <% } %>
            <div class="resume-match-actions">
                <% if (isAdmin) { %>
                    <% if (teams.length < 2) { %>
                        <a href="/teams/new" class="toolbar-btn toolbar-btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Teams First</span>
                        </a>
                    <% } else { %>
                        <button type="button" class="toolbar-btn toolbar-btn-primary" id="addMatchBtn">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Match</span>
                        </button>
                    <% } %>
                    <button type="button" class="toolbar-btn" id="tournamentSettingsBtn">
                        <i class="fa-solid fa-gear"></i>
                        <span>Tournament Settings</span>
                    </button>
                    <form action="/tcl/session/<%= tournament._id %>/delete" method="POST"
                          onsubmit="return confirm('Delete this tournament? This permanently removes it and every match scheduled inside it. This cannot be undone.');">
                        <button type="submit" class="toolbar-btn toolbar-btn-danger">
                            <i class="fa-solid fa-trash"></i>
                            <span>Delete Tournament</span>
                        </button>
                    </form>
                    <details class="tcl-more-actions">
                        <summary class="toolbar-btn" title="More tournament actions" aria-label="More tournament actions">
                            <i class="fa-solid fa-ellipsis"></i>
                        </summary>
                        <form action="/tcl/session/<%= tournament._id %>/turf-mvp" method="POST"
                              onsubmit="return confirm('Award Turf MVP for this completed tournament? This can only be done once.');">
                            <button type="submit" class="toolbar-btn" <%= tournament.turfMvpAwarded ? 'disabled' : '' %>>
                                <i class="fa-solid fa-star"></i>
                                <span><%= tournament.turfMvpAwarded ? 'Turf MVP Awarded' : 'Award Turf MVP' %></span>
                            </button>
                        </form>
                    </details>
                <% } %>
            </div>
        </div>
        <div class="scorecard-tabs" id="turfStatTabs">
            <button type="button" class="scorecard-tab turf-stat-tab active" data-stat="matches">Matches</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="mvp"><i class="fa-solid fa-star"></i> MVP</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="runs">Most Runs</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="sixes">Most Sixes</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="fours">Most Fours</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="wickets">Most Wickets</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="runsconceded">Most Runs Conceded</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="catches">Most Catches</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="average">Best Average</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="strikerate">Best Strike Rate</button>
            <button type="button" class="scorecard-tab turf-stat-tab" data-stat="economy">Best Economy</button>
        </div>

        <div id="turfStatsPanel" style="display:none;">
            <a href="#" class="score-page-back-link" id="backToMatchesBtn" style="margin-bottom:16px;display:inline-flex;">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Tournament</span>
            </a>
            <div id="turfStatsContent"></div>
        </div>

        <div id="turfMatchesPanel">

        <% if (!matches.length) { %>
            <p>No matches scheduled yet in this tournament.</p>
        <% } else { %>
            <%
                // Match numbers follow original creation order (1,2,3...)
                // regardless of the live/upcoming/completed display sort.
                const matchOrder = [...matches].sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
                const matchNumber = (m) => matchOrder.findIndex((x) => String(x._id) === String(m._id)) + 1;
            %>
            <div class="tcl-match-grid">
                <% matches.forEach((m) => { %>
                    <%
                        const started = !!(m.team1.strikerId || m.team2.strikerId || m.team1.legalBalls || m.team2.legalBalls);
                        const statusLabel = m.status === 'completed' ? (m.result || 'Completed') : (started ? 'In Progress' : 'Upcoming');
                        const statusClass = m.status === 'completed' ? 'is-completed' : (started ? 'is-live' : 'is-upcoming');
                        const team1Logo = m.team1TeamId && m.team1TeamId.logo;
                        const team2Logo = m.team2TeamId && m.team2TeamId.logo;
                    %>
                    <a href="/turfs/live/<%= m._id %>" class="tcl-match-card">
                        <div class="tcl-match-card-status <%= statusClass %>"><%= statusLabel %></div>
                        <div class="tcl-match-card-teams">
                            <div class="tcl-match-card-team">
                                <img src="<%= team1Logo || '/images/placeholder-player.svg' %>" alt="<%= m.team1.name %>" class="tcl-match-card-logo" onerror="this.onerror=null;this.src='/images/placeholder-player.svg';">
                                <span class="tcl-match-card-team-name"><%= m.team1.name %></span>
                                <% if (m.status !== 'live' || started) { %>
                                    <span class="tcl-match-card-team-score"><%= m.team1.totalRuns %>/<%= m.team1.wickets %></span>
                                <% } %>
                            </div>
                            <span class="tcl-match-card-vs">VS</span>
                            <div class="tcl-match-card-team">
                                <img src="<%= team2Logo || '/images/placeholder-player.svg' %>" alt="<%= m.team2.name %>" class="tcl-match-card-logo" onerror="this.onerror=null;this.src='/images/placeholder-player.svg';">
                                <span class="tcl-match-card-team-name"><%= m.team2.name %></span>
                                <% if (m.status !== 'live' || started) { %>
                                    <span class="tcl-match-card-team-score"><%= m.team2.totalRuns %>/<%= m.team2.wickets %></span>
                                <% } %>
                            </div>
                        </div>
                        <div class="tcl-match-card-meta">
                            <% if (m.stage === 'superover') { %>Super Over<% } else if (m.stage === 'semifinal') { %>Semifinal<% } else if (m.stage === 'final') { %>Final<% } else { %>Match <%= matchNumber(m) %><% } %>
                            &middot; <%= m.overs %> overs a side
                        </div>
                        <% if (isAdmin && m.status === 'live' && !started) { %>
                            <button type="button" class="toolbar-btn tcl-edit-match-btn" style="display:flex;margin:12px auto 0;"
                                    data-match-id="<%= m._id %>"
                                    data-batting-first="<%= m.battingFirst %>"
                                    data-team1="<%= m.team1.name %>"
                                    data-team2="<%= m.team2.name %>">
                                <i class="fa-solid fa-pen"></i>
                                <span>Edit</span>
                            </button>
                        <% } %>
                    </a>
                <% }) %>
            </div>
        <% } %>
        </div>
    </div>

    <div class="confirm-overlay" id="addMatchOverlay">
        <div class="confirm-modal turf-form-modal">
            <button type="button" class="score-pad-close-btn modal-x-close" id="closeAddMatch" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h2 class="add-player-title">Add Match — <%= tournament.name %></h2>

            <form action="/tcl/session/<%= tournament._id %>/match" method="POST" class="add-player-form">
                <input type="hidden" name="team1Id" id="team1Id" autocomplete="off" required>
                <input type="hidden" name="team2Id" id="team2Id" autocomplete="off" required>

                <div class="tcl-team-matchup" id="tclTeamMatchup"
                     data-teams="<%= JSON.stringify(teams.map(t => ({ id: String(t._id), name: t.name, logo: t.logo }))) %>">
                    <% ['team1', 'team2'].forEach((slot, slotIndex) => { %>
                        <div class="tcl-team-carousel" data-slot="<%= slot %>">
                            <button type="button" class="tcl-team-cycle-btn" data-direction="-1"
                                    aria-label="Previous <%= slot === 'team1' ? 'Team 1' : 'Team 2' %>">
                                <i class="fa-solid fa-caret-up"></i>
                            </button>
                            <div class="tcl-selected-team">
                                <div class="tcl-selected-team-logo">
                                    <img alt="" class="tcl-selected-team-image">
                                </div>
                                <span class="tcl-selected-team-name">Choose a team</span>
                            </div>
                            <button type="button" class="tcl-team-cycle-btn" data-direction="1"
                                    aria-label="Next <%= slot === 'team1' ? 'Team 1' : 'Team 2' %>">
                                <i class="fa-solid fa-caret-down"></i>
                            </button>
                        </div>
                        <% if (slotIndex === 0) { %>
                            <span class="tcl-matchup-vs" aria-hidden="true">VS</span>
                        <% } %>
                    <% }) %>
                </div>

                <div class="form-group">
                    <label>Which team bats first?</label>
                    <div class="toss-choice-group">
                        <label class="toss-choice">
                            <input type="radio" name="battingFirst" value="team1" checked autocomplete="off">
                            <span id="battingFirstTeam1Label">Team 1</span>
                        </label>
                        <label class="toss-choice">
                            <input type="radio" name="battingFirst" value="team2" autocomplete="off">
                            <span id="battingFirstTeam2Label">Team 2</span>
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="toolbar-btn" id="cancelAddMatch">Cancel</button>
                    <button type="submit" class="toolbar-btn toolbar-btn-primary">
                        <i class="fa-solid fa-check"></i>
                        <span>Add Match</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

<% if (isAdmin) { %>
    <div class="confirm-overlay" id="tournamentSettingsOverlay">
        <div class="confirm-modal turf-form-modal">
            <button type="button" class="score-pad-close-btn modal-x-close" id="closeTournamentSettings" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h2 class="add-player-title">Tournament Settings</h2>
            <form action="/tcl/session/<%= tournament._id %>/settings" method="POST" class="add-player-form">
                <div class="form-group">
                    <label for="settingsOvers">Overs per innings</label>
                    <input type="text" name="overs" id="settingsOvers" inputmode="numeric" pattern="[0-9]+" value="<%= tournamentOvers %>" required>
                    <small class="form-hint">Changing overs updates matches that have not started. Live or completed matches stay unchanged.</small>
                </div>
                <div class="form-group">
                    <label class="tcl-toggle-row" for="settingsAllowSuperOver">
                        <span>
                            <strong>Allow Super Over</strong>
                            <small class="form-hint">Create a Super Over when a tournament match is tied.</small>
                        </span>
                        <span class="tcl-toggle">
                            <input type="checkbox" name="allowSuperOver" id="settingsAllowSuperOver" <%= tournament.allowSuperOver ? 'checked' : '' %>>
                            <span class="tcl-toggle-slider"></span>
                        </span>
                    </label>
                </div>
                <div class="form-actions">
                    <button type="button" class="toolbar-btn" id="cancelTournamentSettings">Cancel</button>
                    <button type="submit" class="toolbar-btn toolbar-btn-primary">
                        <i class="fa-solid fa-check"></i>
                        <span>Save Settings</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="confirm-overlay" id="editMatchOverlay">
        <div class="confirm-modal turf-form-modal">
            <button type="button" class="score-pad-close-btn modal-x-close" id="closeEditMatch" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h2 class="add-player-title">Edit Match</h2>
            <form method="POST" id="editMatchForm" class="add-player-form">
                <div class="form-group">
                    <label>Which team bats first?</label>
                    <div class="toss-choice-group">
                        <label class="toss-choice">
                            <input type="radio" name="battingFirst" value="team1" autocomplete="off">
                            <span id="editBatTeam1Label">Team 1</span>
                        </label>
                        <label class="toss-choice">
                            <input type="radio" name="battingFirst" value="team2" autocomplete="off">
                            <span id="editBatTeam2Label">Team 2</span>
                        </label>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="toolbar-btn" id="cancelEditMatch">Cancel</button>
                    <button type="submit" class="toolbar-btn toolbar-btn-primary">
                        <i class="fa-solid fa-check"></i>
                        <span>Save</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <% } %>

<script>
        window.TURF_MATCHES = <%- JSON.stringify(matches) %>;
    </script>
    <!-- mvp.js exposes window.CricketMVP, which turf-stats.js uses to
         compute the cross-match MVP leaderboard points. It must load
         before turf-stats.js so the MVP tab shows real points. -->
    <script src="/js/mvp.js"></script>
    <script src="/js/turf-stats.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const overlay = document.getElementById('addMatchOverlay');
            const addBtn = document.getElementById('addMatchBtn');
            if (addBtn) addBtn.addEventListener('click', () => { overlay.style.display = 'flex'; });
            const params = new URLSearchParams(window.location.search);
            if (params.get('addMatch') === '1' && addBtn && overlay) {
                overlay.style.display = 'flex';
                params.delete('addMatch');
                const nextQuery = params.toString();
                window.history.replaceState({}, '', window.location.pathname + (nextQuery ? '?' + nextQuery : '') + window.location.hash);
            }
            document.querySelectorAll('#cancelAddMatch, #closeAddMatch').forEach((btn) => {
                btn.addEventListener('click', () => { overlay.style.display = 'none'; });
            });

            const settingsOverlay = document.getElementById('tournamentSettingsOverlay');
            const settingsBtn = document.getElementById('tournamentSettingsBtn');
            if (settingsOverlay && settingsBtn) {
                settingsBtn.addEventListener('click', () => { settingsOverlay.style.display = 'flex'; });
                document.querySelectorAll('#cancelTournamentSettings, #closeTournamentSettings').forEach((btn) => {
                    btn.addEventListener('click', () => { settingsOverlay.style.display = 'none'; });
                });
            }

            const teamInputs = {
                team1: document.getElementById('team1Id'),
                team2: document.getElementById('team2Id')
            };
            const matchup = document.getElementById('tclTeamMatchup');
            const availableTeams = JSON.parse(matchup.dataset.teams);
            const selectedTeams = { team1: -1, team2: -1 };

            function renderTeam(slot) {
                const carousel = matchup.querySelector('.tcl-team-carousel[data-slot="' + slot + '"]');
                const team = availableTeams[selectedTeams[slot]];
                const image = carousel.querySelector('.tcl-selected-team-image');
                const name = carousel.querySelector('.tcl-selected-team-name');
                teamInputs[slot].value = team ? team.id : '';
                name.textContent = team ? team.name : 'Choose a team';
                image.src = team ? team.logo : '/images/placeholder-player.svg';
                image.alt = team ? team.name : '';
                const battingLabel = document.getElementById(slot === 'team1' ? 'battingFirstTeam1Label' : 'battingFirstTeam2Label');
                battingLabel.textContent = team ? team.name : (slot === 'team1' ? 'Team 1' : 'Team 2');
            }

            function changeTeam(slot, direction) {
                if (availableTeams.length < 2) return;
                const otherSlot = slot === 'team1' ? 'team2' : 'team1';
                const otherTeam = availableTeams[selectedTeams[otherSlot]];
                let nextIndex = selectedTeams[slot];
                for (let attempt = 0; attempt < availableTeams.length; attempt += 1) {
                    nextIndex = (nextIndex + direction + availableTeams.length) % availableTeams.length;
                    if (!otherTeam || availableTeams[nextIndex].id !== otherTeam.id) {
                        selectedTeams[slot] = nextIndex;
                        renderTeam(slot);
                        return;
                    }
                }
            }

            if (availableTeams.length > 0) {
                selectedTeams.team1 = 0;
                selectedTeams.team2 = availableTeams.length > 1 ? 1 : 0;
                renderTeam('team1');
                renderTeam('team2');
            }
            matchup.querySelectorAll('.tcl-team-cycle-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    const slot = button.closest('.tcl-team-carousel').dataset.slot;
                    changeTeam(slot, Number(button.dataset.direction));
                });
            });

            const editOverlay = document.getElementById('editMatchOverlay');
            if (editOverlay) {
                const editForm = document.getElementById('editMatchForm');
                document.querySelectorAll('.tcl-edit-match-btn').forEach((btn) => {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault(); // the whole card is a link to the live page
                        e.stopPropagation();
                        editForm.action = '/tcl/session/<%= tournament._id %>/match/' + btn.dataset.matchId + '/edit';
                        document.getElementById('editBatTeam1Label').textContent = btn.dataset.team1;
                        document.getElementById('editBatTeam2Label').textContent = btn.dataset.team2;
                        editForm.querySelector('input[name="battingFirst"][value="' + btn.dataset.battingFirst + '"]').checked = true;
                        editOverlay.style.display = 'flex';
                    });
                });
                document.querySelectorAll('#cancelEditMatch, #closeEditMatch').forEach((b) => {
                    b.addEventListener('click', () => { editOverlay.style.display = 'none'; });
                });
            }

            document.querySelector('#addMatchOverlay form').addEventListener('submit', (e) => {
                if (!teamInputs.team1.value || !teamInputs.team2.value || teamInputs.team1.value === teamInputs.team2.value) {
                    e.preventDefault();
                    alert('Please select both teams.');
                }
            });
        });
    </script>

    <%- include('../includes/scripts.ejs') %>
</body>
</html>